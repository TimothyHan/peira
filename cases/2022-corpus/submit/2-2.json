{
  "$schema": "../../../schema/case.schema.json",
  "id": "CASE-2022-2-2",
  "title": "2.2 As submit endpoint, I should return 400 Bad request or 422 Unprocessable Entity when the request payload does not only contain code field and value",
  "from": {
    "intent": "post-groovy-submit",
    "hash": "08cc92149789"
  },
  "test": {
    "request": {
      "method": "post",
      "route": "/groovy/submit",
      "auth": "$users.user_1",
      "body": {
        "code": "1 + 2",
        "garbage": "I should not be here"
      }
    },
    "expect": {
      "status": 400,
      "body": {
        "error": "Bad Request",
        "message": "",
        "path": "/groovy/submit",
        "status": 400,
        "timestamp": {
          "$any": "string"
        }
      }
    }
  }
}
