{
  "id": "CASE-failed-result-carries-error-message-011",
  "title": "4.4 As a service, I should mark the request status as FAILED, and provide error message through result field",
  "setup": [
    {
      "request": {
        "method": "post",
        "route": "/groovy/submit",
        "auth": "$users.user_1",
        "body": {
          "code": "throw new RuntimeException('peira intentional failure')"
        }
      },
      "capture": {
        "requestId": "body.id"
      },
      "expect": {
        "status": 200
      }
    }
  ],
  "test": {
    "request": {
      "method": "get",
      "route": "/groovy/status",
      "auth": "$users.user_1",
      "query": {
        "id": "$requestId"
      }
    },
    "pollUntil": {
      "until": {
        "status": 200,
        "body": {
          "status": "FAILED"
        }
      },
      "timeoutMs": 15000
    },
    "expect": {
      "status": 200,
      "body": {
        "id": "$requestId",
        "status": "FAILED",
        "result": {
          "$any": "string"
        }
      }
    }
  },
  "from": {
    "intent": "robustness-2",
    "hash": "9b8cd66e6aae"
  }
}
