{
  "id": "CASE-submit-extra-payload-field-002",
  "title": "As a service endpoint, I should return 400 Bad request or 422 Unprocessable Entity when the request payload does not only contain `code` field and value",
  "test": {
    "request": {
      "method": "post",
      "route": "/groovy/submit",
      "auth": "$users.user_1",
