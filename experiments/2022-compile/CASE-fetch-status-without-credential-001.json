{
  "id": "CASE-fetch-status-without-credential-001",
  "title": "1.5 As a user, I should receive 401 Unauthorized when I do not provide any credential",
  "setup": [
    {
      "request": {
        "method": "post",
        "route": "/groovy/submit",
        "auth": "$users.user_1",
        "body": {
          "code": "return 'ok {{unique.nonce}}'"
        }
      },
      "capture": {
        "requestId": "body.id"
      }
    }
  ],
  "test": {
    "request": {
      "method": "get",
      "route": "/groovy/status",
      "query": {
        "id": "$requestId"
      }
    },
    "expect": {
      "status": 401
    }
  },
  "teardown": {
    "drain": true
  },
  "from": {
    "intent": "security-2",
    "hash": "f1a9c46dadcc"
  }
}
