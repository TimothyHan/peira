{
  "id": "CASE-running-request-is-in-progress-013",
  "title": "4.6 As a service, I should mark the request that is running as IN_PROGRESS",
  "setup": [
    {
      "request": {
        "method": "post",
        "route": "/groovy/submit",
        "auth": "$users.user_1",
        "body": {
          "code": "Thread.sleep(20000)"
        }
      },
      "capture": {
        "requestId": "body.id"
      },
      "expect": {
        "status": 200
      }
    }
  ],
  "test": {
    "request": {
      "method": "get",
      "route": "/groovy/status",
      "auth": "$users.user_1",
      "query": {
        "id": "$requestId"
      }
    },
    "pollUntil": {
      "until": {
        "status": 200,
        "body": {
          "status": "IN_PROGRESS"
        }
      },
      "timeoutMs": 15000
    },
    "expect": {
      "status": 200,
      "body": {
        "id": "$requestId",
        "status": "IN_PROGRESS"
      }
    }
  },
  "teardown": {
    "drain": true
  },
  "from": {
    "intent": "robustness-2",
    "hash": "9b8cd66e6aae"
  }
}
