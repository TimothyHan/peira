{
  "id": "CASE-failed-request-is-marked-failed-015",
  "title": "4.8 As a service, I should mark the request that is failed as FAILED",
  "setup": [
    {
      "request": {
        "method": "post",
        "route": "/groovy/submit",
        "auth": "$users.user_1",
        "body": {
          "code": "def z = 0\nreturn 1 / z"
        }
      },
      "capture": {
        "requestId": "body.id"
      },
      "expect": {
        "status": 200
      }
    }
  ],
  "test": {
    "request": {
      "method": "get",
      "route": "/groovy/status",
      "auth": "$users.user_1",
      "query": {
        "id": "$requestId"
      }
    },
    "pollUntil": {
      "until": {
        "status": 200,
        "body": {
          "status": "FAILED"
        }
      },
      "timeoutMs": 15000
    },
    "expect": {
      "status": 200,
      "body": {
        "id": "$requestId",
        "status": "FAILED"
      }
    }
  },
  "from": {
    "intent": "robustness-2",
    "hash": "9b8cd66e6aae"
  }
}
