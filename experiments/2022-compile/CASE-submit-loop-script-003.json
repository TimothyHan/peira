{
  "id": "CASE-submit-loop-script-003",
  "title": "4.1.3 As a user, I should be able to submit any valid groovy scripts — loop",
  "setup": [
    {
      "request": {
        "method": "post",
        "route": "/groovy/submit",
        "auth": "$users.user_1",
        "body": {
          "code": "def sum = 0\nfor (int i = 0; i < 5; i++) { sum += i }\nreturn sum"
        }
      },
      "capture": {
        "requestId": "body.id"
      },
      "expect": {
        "status": 200
      }
    }
  ],
  "test": {
    "request": {
      "method": "get",
      "route": "/groovy/status",
      "auth": "$users.user_1",
      "query": {
        "id": "$requestId"
      }
    },
    "pollUntil": {
      "until": {
        "status": 200,
        "body": {
          "status": "COMPLETED"
        }
      },
      "timeoutMs": 15000
    },
    "expect": {
      "status": 200,
      "body": {
        "id": "$requestId",
        "status": "COMPLETED"
      }
    }
  },
  "from": {
    "intent": "robustness-2",
    "hash": "9b8cd66e6aae"
  }
}
