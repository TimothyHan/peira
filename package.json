{
  "name": "peira",
  "version": "0.1.0",
  "description": "Peira (\u03c0\u03b5\u1fd6\u03c1\u03b1) \u2014 an intent compiler for functional API testing. Under active development.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peira": "bin/peira.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "bench": "npm run build && node bench/bench.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "akela": "^0.1.4"
  }
}
