{
  "name": "peira",
  "version": "0.1.0",
  "description": "Peira (πεῖρα) — an intent compiler for functional API testing. Under active development.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peira": "bin/peira.js"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
