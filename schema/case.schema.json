{
  "$comment": "The case DSL definition (RFC 0001 §4.3). A primitive exists iff this schema admits it. additionalProperties:false at every level — the schema refuses what it does not name.",
  "type": "object",
  "required": [
    "id",
    "from",
    "test"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "$comment": "optional editor association; ignored by the gate"
    },
    "id": {
      "type": "string",
      "pattern": "^CASE-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "from": {
      "$comment": "template/seed/instance appear only on cases minted from an invariant template at run time",
      "type": "object",
      "required": [
        "intent",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{6,64}$"
        },
        "template": {
          "type": "string",
          "pattern": "^TPL-[a-z0-9][a-z0-9-]*$"
        },
        "seed": {
          "type": "integer"
        },
        "instance": {
          "type": "integer"
        }
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/step"
          },
          {
            "$ref": "#/$defs/invocation"
          }
        ]
      }
    },
    "test": {
      "$ref": "#/$defs/step"
    },
    "teardown": {
      "type": "object",
      "required": [
        "drain"
      ],
      "additionalProperties": false,
      "properties": {
        "drain": {
          "enum": [
            true
          ]
        }
      }
    }
  },
  "$defs": {
    "invocation": {
      "$comment": "A step invocation (RFC §4.5): procedure only, setup only. It structurally cannot carry expect or capture — the claim being verified stays in the case's declarative test.",
      "type": "object",
      "required": [
        "step"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "string",
          "pattern": "^STEP-[a-z0-9][a-z0-9-]*$"
        },
        "bind": {
          "type": "object"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "request"
      ],
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "capture": {
          "$comment": "free map: alias -> response path; keys and values are checked statically in validate.js",
          "type": "object"
        },
        "pollUntil": {
          "type": "object",
          "required": [
            "until"
          ],
          "additionalProperties": false,
          "properties": {
            "until": {
              "$ref": "#/$defs/expect"
            },
            "timeoutMs": {
              "type": "integer"
            }
          }
        },
        "expect": {
          "$ref": "#/$defs/expect"
        }
      }
    },
    "request": {
      "type": "object",
      "required": [
        "method",
        "route"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "get",
            "post",
            "put",
            "delete",
            "patch"
          ]
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "query": {
          "type": "object"
        },
        "body": {},
        "auth": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\$users\\.[A-Za-z0-9_]+$"
            },
            {
              "type": "object",
              "required": [
                "username",
                "password"
              ],
              "additionalProperties": false,
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer"
        },
        "body": {},
        "bodySchema": {
          "type": "object"
        }
      }
    }
  }
}
